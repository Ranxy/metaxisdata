{
  "name": "metaxisdata-frontend",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "type-check": "export NODE_OPTIONS=--max_old_space_size=8000 && vue-tsc --build --force",
    "type-check:diagnostics": "export NODE_OPTIONS=--max_old_space_size=8000 && vue-tsc --build --force --extendedDiagnostics",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=coverage/vitest-results.json",
    "i18n": "node scripts/check-vue-i18n.mjs && node scripts/sort_i18n_keys.mjs --check",
    "i18n:sort": "node scripts/sort_i18n_keys.mjs",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint --write .",
    "biome:check": "biome check --write .",
    "biome:ci": "biome ci .",
    "audit:ui": "node scripts/audit-ui-layout.mjs",
    "metrics": "node scripts/frontend-metrics.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@internationalized/date": "^3.12.4",
    "@types/chai": "^5.2.3",
    "@types/deep-eql": "^4.0.2",
    "@types/estree": "^1.0.9",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^15.0.0",
    "baseline-browser-mapping": "^2.11.28",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "lucide-vue-next": "^1.0.0",
    "markstream-vue": "2.0.16",
    "monaco-editor": "^0.57.0",
    "pinia": "4.0.3",
    "radix-vue": "^1.9.17",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "11.2.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": [
    "> 0.08%, not dead"
  ],
  "packageManager": "pnpm@12.10.1"
}
