{
	"name": "metaxisdata-frontend",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
		"type-check": "export NODE_OPTIONS=--max_old_space_size=8000 && vue-tsc --build --force",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"i18n": "TS_NODE_PROJECT='./tsconfig.i18n.json' ts-node i18n.ts && pnpm biome:check",
		"biome:format": "biome format --write .",
		"biome:lint": "biome lint --write .",
		"biome:check": "biome check --write .",
		"biome:ci": "biome ci ."
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.5.2",
		"@connectrpc/connect": "^2.0.0",
		"@connectrpc/connect-web": "^2.0.0",
		"@types/chai": "^5.2.3",
		"@types/deep-eql": "^4.0.2",
		"@types/estree": "^1.0.8",
		"@vueuse/core": "^14.1.0",
		"baseline-browser-mapping": "^2.10.8",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lodash-es": "^4.17.21",
		"lucide-vue-next": "^0.561.0",
		"monaco-editor": "^0.55.1",
		"pinia": "3.0.4",
		"radix-vue": "^1.9.17",
		"sql-formatter": "^15.6.12",
		"tailwind-merge": "^3.4.0",
		"vue": "^3.5.25",
		"vue-i18n": "^9.14.1",
		"vue-router": "^4.6.3",
		"vue-sonner": "^2.0.9"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@eslint/js": "^9.39.2",
		"@intlify/eslint-plugin-vue-i18n": "^4.0.0",
		"@intlify/unplugin-vue-i18n": "11.0.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^24.10.1",
		"@vitejs/plugin-vue": "6.0.2",
		"@vue/eslint-config-typescript": "^14.5.0",
		"@vue/test-utils": "^2.4.6",
		"autoprefixer": "^10.4.20",
		"eslint": "9.39.1",
		"eslint-plugin-vue": "10.6.2",
		"globals": "^16.5.0",
		"jsdom": "^27.3.0",
		"postcss": "^8.4.49",
		"shadcn-vue": "^2.4.3",
		"tailwindcss": "4.1.17",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.16.0",
		"vite": "7.2.6",
		"vitest": "4.0.15",
		"vue-tsc": "3.1.5"
	},
	"browserslist": [
		"> 0.08%, not dead"
	],
	"packageManager": "pnpm@10.24.0"
}
