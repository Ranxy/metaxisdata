        "zh-CN": [
          "字段血缘",
          "字段级血缘"
        ]
      }
    },
    {
      "id": "lineage-graph",
      "category": "Lineage",
      "definition": "The canvas that draws lineage nodes and edges.",
      "translations": {
        "en-US": "lineage graph",
        "zh-CN": "血缘图"
      },
      "scope": [
        "lineageGraph.",
        "openlineage."
      ],
      "avoid": {
        "zh-CN": [
          "图谱"
        ]
      }
    },
    {
      "id": "upstream",
      "category": "Lineage",
      "definition": "The side a lineage edge comes from.",
      "translations": {
        "en-US": "upstream",
        "zh-CN": "上游"
      }
    },
    {
      "id": "downstream",
      "category": "Lineage",
