{
  "categories": {
    "Access": "Workspace identity and authorization.",
    "Conventions": "Voice, casing and spelling rules for both languages.",
    "Data": "Metadata objects the registry syncs.",
    "Data Quality": "The checks that watch the data itself, and their outcomes.",
    "Identity": "Browser login and credentials.",
    "Ingestion": "Applications reporting the SQL they run.",
    "Integration": "Protocols and endpoints this deployment exposes.",
    "Lineage": "How a derivation and its parts are named.",
    "OpenLineage": "The event-ingestion vocabulary.",
    "Platform": "Deployment-level concepts."
  },
  "description": "Canonical terminology for user-facing copy. `translations` fixes the one accepted rendering of a term per locale; `scope` limits the rules to the i18n key prefixes where the term applies (absent scope = every key); `when` fires a rule only on keys whose value in the named locale matches (usually the English source); an `avoid` pattern is a literal substring unless it is written as /regex/flags. Enforced by scripts/check-i18n-glossary.mjs and rendered into .agents/docs/i18n-glossary.md.",
  "locales": [
    "en-US",
    "zh-CN"
  ],
  "terms": [
    {
      "id": "instance",
      "category": "Data",
      "definition": "A registered connection to one database server whose schemas are synced.",
      "translations": {
        "en-US": "instance",
        "zh-CN": "实例"
      }
    },
    {
      "id": "database",
      "category": "Data",
      "definition": "A database inside an instance.",
      "translations": {
        "en-US": "database",
        "zh-CN": "数据库"
      }
    },
    {
      "id": "schema",
      "category": "Data",
      "definition": "The namespace holding a database's tables, views and sequences. Kept in Latin script in Chinese copy.",
      "translations": {
        "en-US": "schema",
        "zh-CN": "Schema"
      },
      "scope": [
        "manualSqlManagement.",
        "metadataBrowser.",
        "openlineage.",
        "explainSQL.",
        "instanceDetail.",
        "oauthConsent.",
        "home."
      ],
      "avoid": {
        "zh-CN": [
          "/(?<!\\{)schema/",
          "模式"
        ]
      }
    },
    {
      "id": "table",
      "category": "Data",
      "definition": "A relation in a schema; its definition is synced and analyzed for lineage.",
      "translations": {
        "en-US": "table",
        "zh-CN": "表"
      }
    },
    {
      "id": "column",
      "category": "Data",
      "definition": "A field of a table or view, and the unit of column-level lineage.",
      "translations": {
        "en-US": "column",
        "zh-CN": "字段"
      },
      "scope": [
        "applicationSql.",
        "home.",
        "metadataBrowser.",
        "lineageGraph.",
        "openlineage.",
        "oauthConsent.",
        "manualSqlManagement.",
        "instanceDetail.",
        "explainSQL.",
        "databaseManagement."
      ],
      "when": {
        "en-US": "/\\bcolumns?\\b/i"
      },
      "avoid": {
        "zh-CN": [
          "/列(?!级|表)/"
        ]
      }
    },
    {
      "id": "sequence",
      "category": "Data",
      "definition": "A database sequence object the metadata browser tracks.",
      "translations": {
        "en-US": "sequence",
        "zh-CN": "序列"
      }
    },
    {
      "id": "view",
      "category": "Data",
      "definition": "A database view, as opposed to the verb \"view\" (查看).",
      "translations": {
        "en-US": "view",
        "zh-CN": "视图"
      }
    },
    {
      "id": "materialized-view",
      "category": "Data",
      "definition": "A materialized view; its definition is analyzed for lineage like a view's.",
      "translations": {
        "en-US": "materialized view",
        "zh-CN": "物化视图"
      }
    },
    {
      "id": "ddl",
      "category": "Data",
      "definition": "The DDL statement that defines a database object.",
      "translations": {
        "en-US": "DDL",
        "zh-CN": "DDL"
      }
    },
    {
      "id": "metadata",
      "category": "Data",
      "definition": "The registry's record of an object's structure and attributes.",
      "translations": {
        "en-US": "metadata",
        "zh-CN": "元数据"
      }
    },
    {
      "id": "metadata-browser",
      "category": "Data",
      "definition": "The page that walks instance → database → schema → table → column.",
      "translations": {
        "en-US": "Metadata Browser",
        "zh-CN": "元数据浏览器"
      }
    },
    {
      "id": "manual-sql",
      "category": "Data",
      "definition": "A hand-written SQL definition stored with an object so it takes part in lineage analysis.",
      "translations": {
        "en-US": "Manual SQL",
        "zh-CN": "手动 SQL"
      }
    },
    {
      "id": "lineage",
      "category": "Lineage",
      "definition": "The derivation of one object or field from another.",
      "translations": {
        "en-US": "lineage",
        "zh-CN": "血缘"
